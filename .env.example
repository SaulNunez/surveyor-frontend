# Postgres credentials used by docker-compose to provision the database container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=surveyor

# Connection string the app and drizzle-kit use. When running outside of
# docker-compose, point this at your own Postgres instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/surveyor

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- AI summaries of open-ended answers (all optional) ---------------------
# With none of these set the feature is simply off: the results page hides the
# Summarize button and says why. Credentials are server-level only -- nothing
# here is ever stored in the database or entered through the UI.
#
# Leave AI_SUMMARY_PROVIDER unset to auto-detect the first provider that has
# credentials, in the order anthropic -> openai -> ollama. Set it to pin one;
# if the named provider is not configured, summarizing fails with a clear
# error instead of silently billing a different account.
AI_SUMMARY_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional; for Azure OpenAI or another OpenAI-compatible gateway.
OPENAI_BASE_URL=

# Ollama needs no credential -- setting the base URL is what enables it.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
